{
  "title": "Driftline Scorer",
  "uid": "driftline-scorer",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Request rate (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "rate(driftline_score_requests_total[1m])", "legendFormat": "req/s" }
      ]
    },
    {
      "id": 2,
      "title": "Latency percentiles",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(driftline_score_latency_seconds_bucket[5m]))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, rate(driftline_score_latency_seconds_bucket[5m]))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, rate(driftline_score_latency_seconds_bucket[5m]))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 3,
      "title": "Fraud score distribution (rate per bucket)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "rate(driftline_fraud_score_bucket[5m])", "legendFormat": "{{le}}" }
      ]
    },
    {
      "id": 4,
      "title": "Velocity feature hit rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "rate(driftline_velocity_feature_hits_total[1m]) / rate(driftline_score_requests_total[1m])", "legendFormat": "hit rate" }
      ]
    }
  ]
}
